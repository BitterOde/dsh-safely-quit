{
  "name": "dsh-safely-quit",
  "version": "0.0.1",
  "private": true,
  "description": "SafelyQuit：给 DSH 一个体面的关闭入口 —— 在跑的会话各自跑完当前一步后停止并登记，全部停稳后关闭宿主；下次启动按清单把被这次关闭打断的会话接回去接着跑（宿主播一条插件来源的续行消息并唤醒驱动，只跑这一轮：不自动续跑、不发用户消息、不设目标）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "check": "node tools/check-client.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BitterOde/dsh-safely-quit.git"
  },
  "author": "BitterOde",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "graceful-shutdown",
    "session-resume"
  ],
  "license": "UNLICENSED"
}
